PORT=4000
HOST=127.0.0.1
# Set to true when running behind a reverse proxy (e.g. nginx, Caddy, AWS ALB)
TRUST_PROXY=false
ISSUER=http://localhost:4000
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me-now
# Required in production — used to sign HTTP cookies. Generate with: openssl rand -hex 32
COOKIE_SECRET=
ADMIN_NAME=Platform Administrator
ADMIN_USERNAME=admin
AUTO_SETUP=true

# Optional container init helpers
MIGRATE_FROM_SQLITE_PATH=
INIT_SENTINEL_PATH=./data/.container-init-complete

# Optional email delivery defaults (can also be configured in Admin > Administration)
# EMAIL_TRANSPORT: disabled | log | smtp
EMAIL_TRANSPORT=log
EMAIL_FROM=no-reply@example.local
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# Optional OIDC federation providers
# Example:
# FEDERATION_PROVIDERS_JSON=[{"id":"google","label":"Google","authorizationEndpoint":"https://accounts.google.com/o/oauth2/v2/auth","tokenEndpoint":"https://oauth2.googleapis.com/token","userInfoEndpoint":"https://openidconnect.googleapis.com/v1/userinfo","clientId":"your-client-id","clientSecret":"your-client-secret","scopes":["openid","profile","email"]}]
FEDERATION_PROVIDERS_JSON=[]

# Allowed CORS origins, comma-separated (e.g. https://app.example.com,https://admin.example.com)
CORS_ORIGIN=

# Request-level SQL injection guard (set to false to disable)
SQLI_GUARD_ENABLED=true

# Account lockout and session anomaly detection
LOGIN_LOCKOUT_THRESHOLD=5
LOGIN_LOCKOUT_MS=900000
LOGIN_FAILURE_WINDOW_MS=900000
SESSION_ANOMALY_CONCURRENCY_THRESHOLD=5
